problem5: swaping of 2 variables using pointers and using fucntions
  include<iostream>
using namespace std;

void swapNumber(int *ptr1 , int *ptr2){
    int temp = *ptr1;
    *ptr1 = *ptr2;
    *ptr2 = temp;
}

int main() {
    int a, b;
    cin >> a;
    cin >>b;
    swapNumber(&a, &b);
    cout << a <<" " <<b;
}

